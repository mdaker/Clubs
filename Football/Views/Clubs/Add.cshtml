@model Club

<form asp-action="Add" asp-controller="Clubs" method="post">
	Name<input asp-for="Name"  />
	City<input asp-for="City" />

	<button class="btn btn-primary" type="submit">Save</button>
</form>
@if (ViewData["Error"] == "1")
{
	<span class="text-danger">@ViewData["Msg"]</span>
}
else
{
	<span class="text-success">@ViewData["Msg"]</span>
}