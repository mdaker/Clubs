@model Club

<form asp-action="Edit" asp-controller="Clubs" method="post">
	Id<input asp-for="Id" disabled  />
	Name<input asp-for="Name"  />
	City<input asp-for="City" />
	<button class="btn" type="submit">
		<i class="fa-solid fa-floppy-disk fa-lg"></i>
	</button>
</form>

@if (ViewData["Error"] == "1")
{
	<span class="text-danger">@ViewData["Msg"]</span>
}
else
{
	<span class="text-success">@ViewData["Msg"]</span>
}