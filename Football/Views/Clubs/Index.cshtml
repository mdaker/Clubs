@model IEnumerable<Club>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    int a = 1;
}

<h1>Clubs</h1>
<table class="table">
    <tr>
        <th>No</th>
        <th>Name</th>
        <th>City</th>
        <th>Edit</th>
        <th>Delete</th>

    </tr>
    

@foreach(var club in Model)
{
    <tr>
        <td>@a</td>
        <td>@club.Name</td>
        <td>@club.City</td>
            <td><a asp-controller="Clubs" asp-action="Edit" asp-route-id="@club.Id">
                    <i class="fa-solid fa-pen-to-square fa-lg"></i>
                    
            </a>
            </td>
            <td>
                <form asp-action="Delete" asp-controller="Clubs" method="post">
                    <input type="hidden" name="Id" value="@club.Id" />
                    <button id="sub" type="submit"><i class="fa-solid fa-xmark fa-lg text-danger"></i></button>
                </form>
                
        </td>
        </tr>
        a++;
    }

</table>