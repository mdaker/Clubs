@model IEnumerable<Club>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>Clubs</h1>
<table class="table">
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>City</th>
        <th>Edit</th>

    </tr>
    

@foreach(var club in Model)
{
    <tr>
        <td>@club.Id</td>
        <td>@club.Name</td>
        <td>@club.City</td>
            <td><a class="btn btn-primary" asp-controller="Clubs" asp-action="Edit" asp-route-id="@club.Id">Edit</a></td>
    </tr>
}

</table>