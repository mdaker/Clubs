@model IEnumerable<Club>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    int a = 1;
}

<h1>Clubs</h1>
<table class="table">
    <tr>
        <th>No</th>
        <th>Name</th>
        <th>City</th>
        <th>Edit</th>
        <th>Delete</th>

    </tr>
    

@foreach(var club in Model)
{
    <tr>
        <td>@a</td>
        <td>@club.Name</td>
        <td>@club.City</td>
            <td><a asp-controller="Clubs" asp-action="Edit" asp-route-id="@club.Id">
                    <i class="fa-solid fa-pen-to-square fa-lg"></i>
                    
            </a>
            </td>
            <td>
                <a id="deletebtn_@club.Id" href="#" class="m-1" title="Delete Club"
                   onclick="confirmDelete('@club.Id', true)">
                    <i class="fas fa-trash-alt fa-lg text-danger"></i>
                </a>
                <form asp-action="Delete" asp-controller="Clubs" method="post">
                    <span id="confirmDeleteSpan_@club.Id" style="display:none;">
                        <span>Are you sure you want to delete?</span>
                        <button type="submit" class="btn btn-danger">Yes <i class="fas fa-check"></i></button>
                        <a href="#" class="btn btn-primary"
                           onclick="confirmDelete('@club.Id', false)">No <i class="fas fa-times"></i></a>
                        <input type="hidden" name="Id" value="@club.Id" />
                        
                    </span>
                </form>
                
        </td>
        </tr>
        a++;
    }

</table>